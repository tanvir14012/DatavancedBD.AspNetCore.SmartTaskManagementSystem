# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx}]
quote_type = single

[*.html]
indent_size = 2

[*.{css,scss}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
