# Copy to .env for local acceptance runs. Never commit real credentials.
PORT=3002
NESTJS_CUTOVER_ENABLED=true
TENANT_REGION=local
JWT_ISSUER=accept-issuer
JWT_AUDIENCE=accept-audience
JWT_KEY=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=https://localhost:5173,https://localhost:5174

# System catalog connection. Replace the password and keep this URL private.
CATALOG_DATABASE_URL=sqlserver://127.0.0.1:56093;user=sa;password=replace-me;encrypt=true;trustServerCertificate=true;database=StmsNestCatalog;schema=catalog

# Authorized tenant targets. The connection strings omit schema; the runtime appends the
# authorized schema from catalog placement metadata.
TENANT_STORAGE_TARGETS=[{"targetId":"acceptdb","region":"local","isolation":0,"schema":"dbo","connectionString":"sqlserver://127.0.0.1:56093;user=sa;password=replace-me;encrypt=true;trustServerCertificate=true;database=StmsLocalNestDbA","commandTimeoutSeconds":30},{"targetId":"acceptschema","region":"local","isolation":1,"schema":"alpha","connectionString":"sqlserver://127.0.0.1:56093;user=sa;password=replace-me;encrypt=true;trustServerCertificate=true;database=StmsLocalNestSchema","commandTimeoutSeconds":30},{"targetId":"acceptrow","region":"local","isolation":2,"schema":"dbo","connectionString":"sqlserver://127.0.0.1:56093;user=sa;password=replace-me;encrypt=true;trustServerCertificate=true;database=StmsLocalNestRow","commandTimeoutSeconds":30}]

NESTJS_TEST_EMAIL_PREFIX=accept
NESTJS_TEST_PASSWORD=replace-with-local-test-password
