{
  "name": "@datavancedbd/smart-task-management-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint src test",
    "format:check": "prettier --check src test package.json tsconfig.json",
    "format": "prettier --write src test package.json tsconfig.json",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@prisma/client": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "prisma": "6.19.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
