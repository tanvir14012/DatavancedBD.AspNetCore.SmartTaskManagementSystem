{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://stms.com",
      "http://stms.com"
    ]
  },
  "Jwt": {
    "Issuer": "https://stms.com",
    "Audience": "https://stms.com",
    "Key": ""
  },
  "Authentication": {
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7,
    "RefreshTokenCookieName": "stms_refresh_token"
  },
  "Ai": {
    "Enabled": true,
    "GroqApiKey": "",
    "GroqEndpoint": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b"
  },
  "Caching": {
    "Provider": "Memory",
    "KeyPrefix": "stms",
    "DefaultAbsoluteExpirationSeconds": 300,
    "DefaultSlidingExpirationSeconds": null,
    "EnableCompression": true,
    "CompressionThresholdBytes": 1024,
    "UseCamelCaseJson": true,
    "Memory": {
      "SizeLimit": 268435456
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "",
      "ConnectRetry": 3,
      "ConnectTimeoutMilliseconds": 5000,
      "SyncTimeoutMilliseconds": 5000
    },
    "HttpResponse": {
      "KeyNamespace": "http",
      "DefaultDurationSeconds": 60,
      "CacheAuthenticatedUser": false,
      "IncludeQueryString": true,
      "VaryByHeaders": []
    },
    "EntityFramework": {
      "KeyNamespace": "ef",
      "DefaultExpirationSeconds": 300
    }
  },
  "Observability": {
    "Loki": {
      "Endpoint": "",
      "Tenant": "shared"
    },
    "Otlp": {
      "TracesEndpoint": "",
      "MetricsEndpoint": ""
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 10
    },
    "Upload": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Strict": {
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
